# kev console —— 数据库后端切换（启动前设置，运行期不可改）
#
# 默认 sqlite（开发/单机）。取消下面 sqlite 段的注释、或设后端为 postgres 切换。
# 详见 docs/medical/runbook-train_cn.md §7.0。

# ---- sqlite（默认）----
# KEV_CONSOLE_DB_BACKEND=sqlite
# KEV_CONSOLE_DB_PATH=data/console/kev-console.db
# 兼容旧变量（仅 sqlite 路径兜底）：
# KEV_CONSOLE_DB=data/console/kev-console.db

# ---- postgresql（多实例共享 / 生产）----
# KEV_CONSOLE_DB_BACKEND=postgres
# KEV_CONSOLE_DB_HOST=127.0.0.1
# KEV_CONSOLE_DB_PORT=5432
# KEV_CONSOLE_DB_USER=kev
# KEV_CONSOLE_DB_PASSWORD=changeme
# KEV_CONSOLE_DB_NAME=kev_console
# 可选：指定 search_path
# KEV_CONSOLE_DB_SCHEMA=public

# 服务端口（默认 8790）
# KEV_CONSOLE_PORT=8790
