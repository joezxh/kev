# kev console —— 数据库后端配置
# 详见 docs/medical/runbook-train_cn.md §7.0

# 使用 postgresql 后端（多实例共享 / 生产）
KEV_CONSOLE_DB_BACKEND=postgres
KEV_CONSOLE_DB_HOST=localhost
KEV_CONSOLE_DB_PORT=5432
KEV_CONSOLE_DB_USER=ai-user
KEV_CONSOLE_DB_PASSWORD=admin123
KEV_CONSOLE_DB_NAME=kev_db

# 可选：指定 search_path（缺省 public）
# KEV_CONSOLE_DB_SCHEMA=public

# 服务端口（默认 8790）
# KEV_CONSOLE_PORT=8790
