{
  "name": "静态无错、一条记录也产不出的 spec（gate G3 的另一半）",
  "domain": "PR2b 的反例，不是场景",
  "state": "一个字段，规则的条件它在数学上永远满足不了",
  "questions": {
    "grade": {
      "type": "choice",
      "instructions": "评级？",
      "criteria": {
        "a": "A",
        "b": "B"
      }
    }
  },
  "guidance": "名字、键、算子都对，静态检查挑不出毛病；但 `normal [0, 100]` 的分数永远不会大于 1000，而 spec 没写兜底规则，于是每条记录都没有标签、文件是空的。旧的 /generator/validate 对空文件返回 `errors: []`。",
  "variety": [
    "broken"
  ],
  "generator": {
    "fields": [
      {
        "name": "分数",
        "unit": "分",
        "decimals": 1,
        "normal": [
          0,
          100
        ]
      }
    ],
    "rules": [
      {
        "id": "impossible",
        "when": "state['分数'] > 1000",
        "then": [
          {
            "label": "grade",
            "value": "b"
          }
        ]
      }
    ]
  }
}
