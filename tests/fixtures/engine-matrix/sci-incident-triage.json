{
  "name": "集群故障分诊",
  "domain": "PR1b：catalog 形状（gen_triage 的形状）",
  "state": "从故障信号池抽 1-2 条，表面给出摘要、红旗、伴随与待复核文本；urgency / red_flag / needs_test / priority 四个标签属性只进 `_meta.derive`",
  "state_example": {
    "告警摘要": "对象存储写入延迟 P99 上升，值班备注：已通知存储组",
    "红旗信号": "无",
    "伴随信号": [
      "无"
    ],
    "待复核项": "对象存储写入延迟 P99 上升",
    "队列积压": "120.0 个",
    "机房": "华东1"
  },
  "questions": {
    "acuity": {
      "type": "score",
      "instructions": "处置紧急度？",
      "criteria": [
        "记录即可",
        "当班处理",
        "立刻升级",
        "全员呼叫"
      ]
    },
    "immediate_page": {
      "type": "noul",
      "instructions": "是否需要立即呼叫值班工程师？",
      "criteria": {
        "true": "是",
        "false": "否"
      }
    },
    "owning_team": {
      "type": "choice",
      "instructions": "由哪个团队负责？",
      "criteria": {
        "infra": "基础架构",
        "data": "数据平台",
        "security": "安全",
        "unknown": "待指派"
      }
    }
  },
  "guidance": "catalog 的第三种形状，也就是 legacy `gen_triage.py:106-116` 的形状：池里每条候选自带 `urgency`/`red_flag`/`needs_test`/`priority`，这四个属性就是标签本身，所以它们只能待在 `_meta.derive`（D11），G8 断言这四个名字在 `render(state)` 里一个都不出现。表面也照 legacy 的尺度写：`红旗信号` 报的是「哪几条症状是红旗」的名字列表（legacy `red_flags` 就这么印），但 `team` 一个都不印 —— legacy 的 state 里从不出现 department，一旦 surface 用 `attr_of_min(..., 'team')` 打印负责团队，`owning_team` 的答案就 literally 躺在 prompt 里，训练集退化成抄写题；`team` 只作为规则里的标签值出现。标签侧因此只用两个属性算子：`attr_of_max` 取最紧急那条的负责团队，`attr_of_min` 取 priority 最小（最专精）那条的团队，与 `gen_diagnosis.py:102` 的 `min(top, key=priority)` 同形。",
  "variety": [
    "派生标签",
    "表面拼装"
  ],
  "generator": {
    "fields": [
      {
        "name": "故障信号",
        "type": "catalog",
        "category": "signal",
        "draw": {
          "min": 1,
          "max": 2
        },
        "surface": {
          "告警摘要": "join_by(derived['故障信号'], 'name', '，') + '，值班备注：' + pick(NOTES)",
          "红旗信号": "default_if_empty(join_by(where(derived['故障信号'], 'red_flag', True), 'name', '、'), '无')",
          "伴随信号": "default_if_empty(pluck(rest(derived['故障信号']), 'name'), ['无'])",
          "待复核项": "default_if_empty(join_by(where(derived['故障信号'], 'needs_test', True), 'name', '、'), '无')"
        },
        "pool": [
          {
            "name": "GPU 节点连续 ECC 错误",
            "urgency": 3,
            "red_flag": true,
            "needs_test": true,
            "priority": 0,
            "team": "infra"
          },
          {
            "name": "登录审计出现异常来源",
            "urgency": 2,
            "red_flag": true,
            "needs_test": false,
            "priority": 2,
            "team": "security"
          },
          {
            "name": "对象存储写入延迟 P99 上升",
            "urgency": 2,
            "red_flag": false,
            "needs_test": true,
            "priority": 1,
            "team": "data"
          },
          {
            "name": "作业队列积压超过阈值",
            "urgency": 1,
            "red_flag": false,
            "needs_test": false,
            "priority": 3,
            "team": "data"
          },
          {
            "name": "监控采集缺失 5 分钟",
            "urgency": 1,
            "red_flag": false,
            "needs_test": true,
            "priority": 4,
            "team": "infra"
          },
          {
            "name": "依赖库版本回退",
            "urgency": 0,
            "red_flag": false,
            "needs_test": false,
            "priority": 5,
            "team": "unknown"
          },
          {
            "name": "根磁盘使用率 85%",
            "urgency": 0,
            "red_flag": false,
            "needs_test": false,
            "priority": 6,
            "team": "infra"
          },
          {
            "name": "TLS 证书 30 天后到期",
            "urgency": 0,
            "red_flag": false,
            "needs_test": true,
            "priority": 7,
            "team": "security"
          }
        ]
      },
      {
        "name": "队列积压",
        "unit": "个",
        "decimals": 0,
        "category": "capacity",
        "normal": [0, 200],
        "critical": {
          "high": [
            [
              180,
              1000000000.0
            ]
          ]
        }
      },
      {
        "name": "机房",
        "type": "enum",
        "category": "region",
        "values": [
          "华东1",
          "华北2",
          "海外"
        ]
      }
    ],
    "pools": {
      "NOTES": [
        "已通知存储组",
        "值班已确认但未回复",
        "关联变更刚刚发布",
        "同一节点今天第二次"
      ]
    },
    "selectors": [],
    "tier_windows": {},
    "panel_category": {},
    "plan_targets": {},
    "rules": [
      {
        "when": "len(where(derived['故障信号'], 'red_flag', True)) > 0",
        "then": [
          {
            "label": "acuity",
            "value": "3"
          },
          {
            "label": "immediate_page",
            "value": true
          },
          {
            "label": "owning_team",
            "value": "attr_of_max(derived['故障信号'], 'urgency', 'team')"
          }
        ]
      },
      {
        "when": "max_attr(derived['故障信号'], 'urgency') >= 2",
        "then": [
          {
            "label": "acuity",
            "value": "max_attr(derived['故障信号'], 'urgency')"
          },
          {
            "label": "immediate_page",
            "value": false
          },
          {
            "label": "owning_team",
            "value": "attr_of_min(derived['故障信号'], 'priority', 'team')"
          }
        ]
      },
      {
        "when": "max_attr(derived['故障信号'], 'urgency') == 1",
        "then": [
          {
            "label": "acuity",
            "value": "1"
          },
          {
            "label": "immediate_page",
            "value": false
          },
          {
            "label": "owning_team",
            "value": "attr_of_min(derived['故障信号'], 'priority', 'team')"
          }
        ]
      },
      {
        "when": "True",
        "then": [
          {
            "label": "acuity",
            "value": "0"
          },
          {
            "label": "immediate_page",
            "value": false
          },
          {
            "label": "owning_team",
            "value": "attr_of_min(derived['故障信号'], 'priority', 'team')"
          }
        ]
      }
    ],
    "augmentation": {}
  }
}
