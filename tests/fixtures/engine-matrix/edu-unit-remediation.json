          "low": [
            [
              0,
              55
            ]
          ]
        }
      },
      {
        "name": "年级",
        "type": "enum",
        "category": "grade",
        "values": [
          "初二",
          "初三",
          "高一"
        ]
      }
    ],
    "pools": {
      "COMMENTS": [
        "课本作业能做完但综合题没思路",
        "上课能听懂但作业错得多",
        "前一章也没学扎实",
        "只想知道考试会考哪几类"
      ]
    },
    "selectors": [],
    "tier_windows": {},
    "panel_category": {},
    "plan_targets": {},
    "rules": [
      {
        "when": "len(where(derived['薄弱单元'], 'prerequisite', True)) > 1",
        "then": [
          {
            "label": "plan",
            "value": "full"
          },
          {
            "label": "schedule_before_term",
            "value": true
          }
        ]
      },
      {
        "when": "max_attr(derived['薄弱单元'], 'priority') >= 2",
        "then": [
          {
            "label": "plan",
            "value": "refresher"
          },
          {
            "label": "schedule_before_term",
            "value": true
          }
        ]
      },
      {
        "when": "min_attr(derived['薄弱单元'], 'priority') >= 1",
        "then": [
          {
            "label": "plan",
            "value": "refresher"
          },
          {
            "label": "schedule_before_term",
            "value": false
          }
        ]
      },
      {
        "when": "True",
        "then": [
          {
            "label": "plan",
            "value": "quick"
          },
          {
            "label": "schedule_before_term",
            "value": false
          }
