          {
            "name": "函数图象",
            "priority": 1,
            "prerequisite": true,
            "hours": 2
          },
          {
            "name": "统计图表",
            "priority": 1,
            "prerequisite": false,
            "hours": 2
          },
          {
            "name": "圆的基本性质",
            "priority": 0,
            "prerequisite": false,
            "hours": 1
          },
          {
            "name": "概率初步",
            "priority": 0,
            "prerequisite": false,
            "hours": 1
          }
        ]
      },
      {
        "name": "近四周作业完成率",
