{
  "name": "拟提交证据评估",
  "domain": "PR1b：catalog 形状",
  "state": "从证据池抽 1-3 项，表面只给清单、排除项与对方异议焦点；证明力、偏见性与是否被排除留在 `_meta.derive`",
  "state_example": {
    "证据清单": "证人书面陈述、第三方鉴定意见，提交方申请证人出庭",
    "排除项": "无",
    "对方异议焦点": [
      "第三方鉴定意见"
    ],
    "举证期限剩余": "32.0 天",
    "程序": "一审"
  },
  "questions": {
    "admissible": {
      "type": "noul",
      "instructions": "这批证据是否可以整体提交？",
      "criteria": {
        "true": "可以",
        "false": "不可以"
      }
    },
    "weight": {
      "type": "choice",
      "instructions": "这批证据对事实认定的分量？",
      "criteria": {
        "decisive": "决定性",
        "moderate": "有影响",
        "negligible": "可忽略"
      }
    }
  },
  "guidance": "catalog 的第四条：同一个池里两类属性互相拉扯——`probative` 越高越有分量，`prejudicial` 越高越该被排除，规则同时读这两个属性才给得出标签，而 state 只报清单。这条也是四份里唯一让「属性值」参与比较而不只是「属性存在性」的（`max_attr(...) >= 3 and max_attr(...) <= 2`）。",
  "variety": [
    "派生标签",
    "表面拼装"
  ],
  "generator": {
    "fields": [
      {
        "name": "拟提交证据",
        "type": "catalog",
        "category": "evidence",
        "draw": {
          "min": 1,
          "max": 3
        },
        "surface": {
          "证据清单": "join_by(derived['拟提交证据'], 'name', '、') + '，' + pick(REMARKS)",
          "排除项": "default_if_empty(join_by(where(derived['拟提交证据'], 'excluded', True), 'name', '、'), '无')",
          "对方异议焦点": "default_if_empty(pluck(where(derived['拟提交证据'], 'prejudicial', 3), 'name'), ['无异议对象'])"
        },
        "pool": [
          {
            "name": "现场监控录像",
            "probative": 3,
            "prejudicial": 1,
            "excluded": false
          },
          {
            "name": "第三方鉴定意见",
            "probative": 3,
            "prejudicial": 3,
            "excluded": false
          },
          {
            "name": "证人书面陈述",
            "probative": 2,
            "prejudicial": 1,
            "excluded": false
          },
          {
            "name": "未经同意的私人通话录音",
            "probative": 2,
            "prejudicial": 3,
            "excluded": true
          },
          {
            "name": "被告前科材料",
            "probative": 1,
            "prejudicial": 3,
            "excluded": true
          },
          {
            "name": "快递签收记录",
            "probative": 1,
            "prejudicial": 0,
            "excluded": false
          }
        ]
      },
      {
        "name": "举证期限剩余",
        "unit": "天",
        "decimals": 0,
        "category": "deadline",
        "normal": [15, 60],
        "critical": {
          "low": [
            [
              0,
              10
            ]
          ]
        }
      },
      {
        "name": "程序",
        "type": "enum",
        "category": "stage",
        "values": [
          "一审",
          "二审",
          "再审"
        ]
      }
    ],
    "pools": {
      "REMARKS": [
        "对方已申请排除非法证据",
        "证据原件在案",
        "仅有复印件且无核对记录",
        "提交方申请证人出庭"
      ]
    },
    "selectors": [],
    "tier_windows": {},
    "panel_category": {},
    "plan_targets": {},
    "rules": [
      {
        "when": "len(where(derived['拟提交证据'], 'excluded', True)) > 0",
        "then": [
          {
            "label": "admissible",
            "value": false
          },
          {
            "label": "weight",
            "value": "negligible"
          }
        ]
      },
      {
        "when": "max_attr(derived['拟提交证据'], 'probative') >= 3 and max_attr(derived['拟提交证据'], 'prejudicial') <= 2",
        "then": [
          {
            "label": "admissible",
            "value": true
          },
          {
            "label": "weight",
            "value": "decisive"
          }
        ]
      },
      {
        "when": "max_attr(derived['拟提交证据'], 'probative') >= 2",
        "then": [
          {
            "label": "admissible",
            "value": true
          },
          {
            "label": "weight",
            "value": "moderate"
          }
        ]
      },
      {
        "when": "True",
        "then": [
          {
            "label": "admissible",
            "value": true
          },
          {
            "label": "weight",
            "value": "negligible"
          }
        ]
      }
    ],
    "augmentation": {}
  }
}
