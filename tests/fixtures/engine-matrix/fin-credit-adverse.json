{
  "name": "征信风险事件复核",
  "domain": "PR1b：catalog 形状",
  "state": "从风险事件池抽 1-2 条，表面只留事件名称与客户补充，严重度与是否需复核留在 `_meta.derive`",
  "state_example": {
    "事件摘要": "担保代偿记录；手机号在网不足6个月，客户补充：客户提供法院结案证明",
    "复核清单": "担保代偿记录",
    "近90天审批查询": "14.0 次",
    "账户状态": "正常"
  },
  "questions": {
    "risk_grade": {
      "type": "choice",
      "instructions": "该客户的风险等级？",
      "criteria": {
        "severe": "高危",
        "high": "较高",
        "medium": "中等",
        "low": "低"
      }
    },
    "file_review": {
      "type": "noul",
      "instructions": "是否需要人工复核征信档案？",
      "criteria": {
        "true": "是",
        "false": "否"
      }
    }
  },
  "guidance": "catalog 形状的最小样例（设计文档 D10/D11）：候选项自带标签属性，规则读 `derived`，state 只读到 `surface` 拼出的文本。三条字段（一个池 + 两个同伴）是刻意的：今天采样器还按「2-5 个同伴」抽（D6 把它交给 selectors 是 PR3），字段数超过三条就会有些记录抽不到池、`_meta.derive` 变空，G8 与派生标签的断言就只能是「至少若干条」而不是「每一条」。",
  "variety": [
    "派生标签",
    "表面拼装"
  ],
  "generator": {
    "fields": [
      {
        "name": "风险事件",
        "type": "catalog",
        "category": "credit",
        "draw": {
          "min": 1,
          "max": 2
        },
        "surface": {
          "事件摘要": "join_by(derived['风险事件'], 'name', '；') + '，客户补充：' + pick(REMARKS)",
          "复核清单": "default_if_empty(join_by(where(derived['风险事件'], 'reviewable', True), 'name', '、'), '无需复核事项')"
        },
        "pool": [
          {
            "name": "信用卡近2年连续3期逾期",
            "severity": 3,
            "reviewable": true,
            "segment": "credit_card"
          },
          {
            "name": "担保代偿记录",
            "severity": 3,
            "reviewable": true,
            "segment": "guarantee"
          },
          {
            "name": "房贷当前逾期1期",
            "severity": 2,
            "reviewable": true,
            "segment": "mortgage"
          },
          {
            "name": "消费贷余额接近授信上限",
            "severity": 1,
            "reviewable": false,
            "segment": "loan"
          },
          {
            "name": "法院被执行记录已履行完毕",
            "severity": 1,
            "reviewable": true,
            "segment": "judicial"
          },
          {
            "name": "手机号在网不足6个月",
            "severity": 0,
            "reviewable": false,
            "segment": "telecom"
          }
        ]
      },
      {
        "name": "近90天审批查询",
        "unit": "次",
        "decimals": 0,
        "category": "velocity",
        "normal": [0, 20],
        "critical": {
          "high": [
            [
              18,
              1000000000.0
            ]
          ]
        }
      },
      {
        "name": "账户状态",
        "type": "enum",
        "category": "account",
        "values": [
          "正常",
          "只收不付",
          "冻结"
        ]
      }
    ],
    "pools": {
      "REMARKS": [
        "客户称已结清",
        "客户未回应补充材料",
        "客户提供法院结案证明",
        "客户申请延期报送"
      ]
    },
    "selectors": [],
    "tier_windows": {},
    "panel_category": {},
    "plan_targets": {},
    "rules": [
      {
        "when": "state['账户状态'] == '冻结'",
        "then": [
          {
            "label": "risk_grade",
            "value": "severe"
          },
          {
            "label": "file_review",
            "value": true
          }
        ]
      },
      {
        "when": "max_attr(derived['风险事件'], 'severity') >= 3",
        "then": [
          {
            "label": "risk_grade",
            "value": "severe"
          },
          {
            "label": "file_review",
            "value": true
          }
        ]
      },
      {
        "when": "max_attr(derived['风险事件'], 'severity') >= 2",
        "then": [
          {
            "label": "risk_grade",
            "value": "high"
          },
          {
            "label": "file_review",
            "value": true
          }
        ]
      },
      {
        "when": "len(where(derived['风险事件'], 'reviewable', True)) > 0",
        "then": [
          {
            "label": "risk_grade",
            "value": "medium"
          },
          {
            "label": "file_review",
            "value": true
          }
        ]
      },
      {
        "when": "True",
        "then": [
          {
            "label": "risk_grade",
            "value": "low"
          },
          {
            "label": "file_review",
            "value": false
          }
        ]
      }
    ],
    "augmentation": {}
  }
}
