{
  "name": "写坏的 spec：未知算子（gate G3）",
  "domain": "PR2b 的反例，不是场景",
  "state": "一个字段，够让求值器走到那条规则",
  "questions": {
    "grade": {
      "type": "choice",
      "instructions": "评级？",
      "criteria": {
        "a": "A",
        "b": "B"
      }
    }
  },
  "guidance": "spec 调用了算子表里没有的 `band`。引擎必须在采样第一条记录之前拒绝它。",
  "variety": [
    "broken"
  ],
  "generator": {
    "fields": [
      {
        "name": "分数",
        "unit": "分",
        "decimals": 1,
        "normal": [
          0,
          100
        ]
      }
    ],
    "rules": [
      {
        "id": "grade-check",
        "when": "band(state['分数']) == 1",
        "then": [
          {
            "label": "grade",
            "value": "a"
          }
        ]
      }
    ]
  }
}
