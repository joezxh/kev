{
  "name": "写坏的 spec：未知 state 键（gate G3）",
  "domain": "PR2b 的反例，不是场景",
  "state": "一个字段，规则读的是另一个名字",
  "questions": {
    "grade": {
      "type": "choice",
      "instructions": "评级？",
      "criteria": {
        "a": "A",
        "b": "B"
      }
    }
  },
  "guidance": "`逾期天数` 从未声明。今天它会变成每条记录都不匹配的 KeyError，被 except 吞掉后全落兜底——静态检查必须在第一条记录之前把它挑出来。",
  "variety": [
    "broken"
  ],
  "generator": {
    "fields": [
      {
        "name": "分数",
        "unit": "分",
        "decimals": 1,
        "normal": [
          0,
          100
        ]
      }
    ],
    "rules": [
      {
        "id": "late-check",
        "when": "state['逾期天数'] > 30",
        "then": [
          {
            "label": "grade",
            "value": "b"
          }
        ]
      },
      {
        "when": "True",
        "then": [
          {
            "label": "grade",
            "value": "a"
          }
        ]
      }
    ]
  }
}
