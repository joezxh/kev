{
  "name": "写坏的 spec：非法 label 值（gate G3）",
  "domain": "PR2b 的反例，不是场景",
  "state": "一个字段，规则把一个问句的标签写错了一个字母",
  "questions": {
    "grade": {
      "type": "choice",
      "instructions": "评级？",
      "criteria": {
        "pass": "通过",
        "fail": "不通过"
      }
    }
  },
  "guidance": "`pas` 既不是这一问的合法标签，也不是可求值的表达式。在它还是 `except Exception: pass` 的年代，这条规则会把字符串 `pas` 一路发到评分端，整个数据集看起来正常。",
  "variety": [
    "broken"
  ],
  "generator": {
    "fields": [
      {
        "name": "分数",
        "unit": "分",
        "decimals": 1,
        "normal": [
          0,
          100
        ]
      }
    ],
    "rules": [
      {
        "id": "grade-label",
        "when": "state['分数'] >= 60",
        "then": [
          {
            "label": "grade",
            "value": "pas"
          }
        ]
      },
      {
        "when": "True",
        "then": [
          {
            "label": "grade",
            "value": "fail"
          }
        ]
      }
    ]
  }
}
