# Local deployment overrides for deploy/docker-compose.yml (read by `docker compose`).
# Reproduces the env that makes the 0.8B server start on this machine:
#   - Hub mode: pull jaredpalmer/kev-0.8b (base + LoRA) instead of the empty local dir
#   - Xet CAS disabled: hf-mirror.com proxy returns 401 for Xet, so use plain HTTP
#   - CUDA graphs / fused kernels off: RTX 5070 Ti (Blackwell, sm_120) hangs during
#     model load with the default cuda_graphs=on / fused=auto
#   - Console is mounted on kev-server:8008 (same container/port) — no separate host
#     service and no host 8790. (KEV_CONSOLE_API is hardcoded in the compose file.)

KEV_RUN=jaredpalmer/kev-0.8b
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_XET=1
KEV_CUDA_GRAPHS=0
KEV_FUSED=0
