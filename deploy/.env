# Local deployment overrides for docker-compose-0.8B.yml (read by `docker compose`).
# These reproduce the env that makes the 0.8B server start on this machine:
#   - Hub mode: pull jaredpalmer/kev-0.8b (base + LoRA) instead of the empty local dir
#   - Xet CAS disabled: hf-mirror.com proxy returns 401 for Xet, so use plain HTTP
#   - CUDA graphs / fused kernels off: RTX 5070 Ti (Blackwell, sm_120) hangs during
#     model load with the default cuda_graphs=on / fused=auto.
#
# NOTE: empty KEV_CUDA_GRAPHS / KEV_FUSED are treated by kev.serve as "unset" (default),
# so removing a line reverts to the upstream default for that knob.

KEV_RUN=jaredpalmer/kev-0.8b
HF_HUB_OFFLINE=0
HF_HUB_DISABLE_XET=1
KEV_CUDA_GRAPHS=0
KEV_FUSED=0

# Playground 的模型调用与 /console UI 都经 kev.console 代理（不是直连 kev-server）。
# 控制台跑在宿主机 WSL2（python -m kev.console，绑 0.0.0.0:8790），容器通过
# host.docker.internal（Docker Desktop WSL2 的 localhostForwarding）访问它。
KEV_CONSOLE_API=http://host.docker.internal:8790/console/api
