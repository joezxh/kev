# ============================================================================
# Kev playground (Next.js) — built from the local source tree (no git clone).
#
# Serves the kev / chess demo UI. The API calls are same-origin (/kev/*) and
# are server-side proxied to the kev-server container; set KEV_API to the
# in-network URL of the server (http://kev-server:8008 in docker-compose).
# ============================================================================

# npm registry for dependency install. Default is the public registry; override
# with a faster mirror (e.g. https://registry.npmmirror.com) when needed.
# NOTE: a build ARG declared before FROM is NOT visible inside a build stage, so it
# must be re-declared after FROM (below) for RUN npm ci to receive it.
ARG NPM_REGISTRY=https://registry.npmjs.org

# ---- 1. deps (cached layer) ----
FROM crpi-c762f77rjuytqer9.cn-hangzhou.personal.cr.aliyuncs.com/llm-basic/node:22-slim AS deps
ARG NPM_REGISTRY=https://registry.npmjs.org
WORKDIR /app
# Build context is the repo root; the app lives in ./playground
COPY playground/package.json playground/package-lock.json ./
RUN npm ci --registry=${NPM_REGISTRY}

# ---- 2. builder ----
FROM crpi-c762f77rjuytqer9.cn-hangzhou.personal.cr.aliyuncs.com/llm-basic/node:22-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
# Next.js rewrites() are evaluated at BUILD time and baked into the routes manifest,
# so KEV_API must be set here (not only at container runtime) to point the /kev proxy
# at the in-network kev-server service name.
ENV KEV_API=http://kev-server:8008
COPY --from=deps /app/node_modules ./node_modules
COPY playground/ ./
RUN npm run build

# ---- 3. runner (standalone) ----
FROM crpi-c762f77rjuytqer9.cn-hangzhou.personal.cr.aliyuncs.com/llm-basic/node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    KEV_API=http://kev-server:8008

# The standalone output is self-contained: ship only server.js + static + public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# server.js is at ./.next/standalone/server.js (or a subfolder); fall back to a find if needed
CMD ["sh", "-c", "exec node $(ls server.js 2>/dev/null || find . -maxdepth 2 -name server.js | head -n1)"]
